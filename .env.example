# Template values only. Configure locally; never commit a real .env.
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017/tasko
MONGO_DATABASE=tasko
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=["http://localhost:3000"]
# false ONLY for local HTTP; production must use HTTPS and true.
COOKIE_SECURE=false
SESSION_HOURS=24
AUTH_RATE_LIMIT=5
API_RATE_LIMIT=120
CACHE_SECONDS=30
CREATE_INDEXES_ON_STARTUP=true
# No JWT signing secret is needed: random opaque session tokens are hashed in MongoDB.
# Compose overrides MONGO_URI and REDIS_URL for its internal service names.
