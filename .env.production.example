# Replace example.com with your actual frontend domain.
ENVIRONMENT=production
COOKIE_SECURE=true
# Required when the HTTPS frontend and API are on different sites.
COOKIE_SAMESITE=none
ALLOWED_ORIGINS=["https://example.com"]
# Compose overrides these with its private MongoDB/Redis service addresses.
# For separately managed databases, supply your own connection URLs securely.
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=tasko
REDIS_URL=redis://redis:6379/0
SESSION_HOURS=24
AUTH_RATE_LIMIT=5
API_RATE_LIMIT=120
CACHE_SECONDS=30
CREATE_INDEXES_ON_STARTUP=true
